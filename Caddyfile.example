# Copy to Caddyfile next to docker-compose.prod.yml, replace the domains
# with your real ones (they must match RAPIDO_DOMAIN / RAPIDO_EXTRA_DOMAINS /
# RAPIDO_SUB_DOMAIN in .env), then
# `docker compose -f docker-compose.prod.yml --env-file .env up -d`.
#
# If you're using rapido-go.sh (the recommended path - see the README),
# it generates this file for you and you can ignore this example - Caddy
# handles obtaining and renewing every certificate on its own from here,
# nothing further to do.
#
# `encode zstd gzip` compresses the dashboard's JavaScript/CSS and the JSON
# API responses - a large saving on the panel's bigger pages and lists.

# The panel: the primary domain first, then any extra domains that should
# serve the same dashboard (comma-separated on ONE line shares one site
# block and one reverse proxy).
panel.example.com {
	encode zstd gzip
	reverse_proxy panel:8000
}

# Optional: a separate subscription domain (or several). Serves only what
# subscribers need - the /sub/* links, the fonts their page uses, and the
# health probe - so the dashboard and admin API are not reachable through
# it. Uncomment and replace the name.
#
# sub.example.com {
# 	encode zstd gzip
# 	@subscriber path / /sub/* /statics/* /health
# 	handle @subscriber {
# 		reverse_proxy panel:8000
# 	}
# 	handle {
# 		respond "Not found" 404
# 	}
# }

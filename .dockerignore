# Keeps the build context small and out of the images. The Dockerfiles copy
# only web/, cmd/, internal/, go.mod, go.sum and sqlc.yaml.
.git
.github
.gitignore
.local-certs
backups
scripts
*.md
*.exe
node.exe

# Root-level environment files hold secrets (the web/ ones are build inputs
# for the dashboard and must stay).
.env
.env.*

# Rebuilt inside the image.
**/node_modules
web/dist
web/stats.html

# Regenerated by `sqlc generate` in the Dockerfile - never copy a stale one in.
internal/db/generated

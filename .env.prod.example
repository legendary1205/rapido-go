# Copy this file to .env next to docker-compose.prod.yml and fill it in,
# then: docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# If you're using rapido-go.sh (the recommended path - see the README),
# it generates this file for you and you can ignore this example.

# The domain you'll open the dashboard on, e.g. panel.example.com - must
# already point at this server. Caddy (the reverse proxy in front of the
# panel) requests a real Let's Encrypt certificate for it; that check is
# done by connecting to the name over the internet. Also written into
# Caddyfile - see that file's own content.
RAPIDO_DOMAIN=panel.example.com

# A real password for the Postgres container - the "rapido" default only
# exists for local development, change it for anything reachable from the
# internet.
POSTGRES_PASSWORD=change-me

# The one-time bootstrap admin login (checked in-memory before the admins
# table is ever queried, so there is always a way in from an empty
# database - see the README's "First login" section). Log in with this
# once, create a real sudo admin from the dashboard, then consider
# rotating this value or removing it from .env afterward.
SUDO_USERNAME=admin
SUDO_PASSWORD=change-me

# The prefix every subscription link is built from - always https, since
# Caddy terminates TLS for RAPIDO_DOMAIN above.
XRAY_SUBSCRIPTION_URL_PREFIX=https://panel.example.com

# This server's public IP - feeds the {SERVER_IP} subscription remark
# placeholder. Leave blank if you don't use that placeholder.
PUBLIC_IP=

# Sent as headers on every subscription fetch, and rendered directly by
# real VPN client apps: SUB_SUPPORT_URL becomes the in-app support button
# and SUB_PROFILE_TITLE the profile's display name, so these are visible to
# your customers. Defaults match the reference panel's own.
SUB_SUPPORT_URL=https://t.me/
SUB_PROFILE_TITLE=Subscription
SUB_UPDATE_INTERVAL=12

# Optional: fully customize the Clash and v2ray-json subscription
# formats - dns/tun/rule-provider settings, a branded proxy-group, local
# inbounds/routing - by dropping a real file at ./templates/<name> (bind-
# mounted read-only into the panel container at /app/templates) and
# pointing these at it. Leave both blank (the default) for a minimal
# built-in profile that only guarantees the subscription can route
# traffic at all - no branding, no ad-block rules.
CLASH_SUBSCRIPTION_TEMPLATE=
V2RAY_SUBSCRIPTION_TEMPLATE=

# Optional: some VPN client apps (v2rayN, v2rayNG, Streisand, Happ, and
# apps built on ktor-client) can receive a full v2ray-json config instead
# of the universal share-link format - but only once you have actually
# confirmed the specific app AND version your users run accepts it, since
# older client-bundled cores reject fields newer JSON configs may carry
# (or the JSON format outright). All false (share-links for everyone) is
# the safe default - turn one on only after a real, successful test.
USE_CUSTOM_JSON_DEFAULT=false
USE_CUSTOM_JSON_FOR_V2RAYN=false
USE_CUSTOM_JSON_FOR_V2RAYNG=false
USE_CUSTOM_JSON_FOR_STREISAND=false
USE_CUSTOM_JSON_FOR_HAPP=false
USE_CUSTOM_JSON_FOR_NPVTUNNEL=false

# Comma-separated CORS allow-list. "*" is fine to start; lock this down
# for a real deployment.
ALLOWED_ORIGINS=*

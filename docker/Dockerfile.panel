# Rapido-Go panel image - builds the dashboard and the panel binary (plus
# goose, for the docker-compose "migrate" service to reuse this same image
# rather than needing a second one), then a small runtime layer with none
# of the build toolchain in it.
#
# Built and pushed automatically by .github/workflows/docker-publish.yml -
# not meant to be built by hand on a target server; see the root
# docker-compose.prod.yml, which just pulls ghcr.io/<owner>/rapido-go-panel.

# --- dashboard -------------------------------------------------------------
FROM node:18-alpine AS dashboard
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# --- goose (migration tool) - its own stage, unrelated to this module's
# go.mod/go.sum, since it's a standalone CLI tool, not an import of the
# project's own code -----------------------------------------------------------
FROM golang:1.27-alpine AS goose
# proxy.golang.org's CDN has answered some specific module zips with a
# bare 403 (confirmed reproducible and global - the exact same URL 403s
# from an unrelated, unrestricted machine too, so it is a real upstream
# gap, not a network block here) - and the go command only falls back to
# GOPROXY's ",direct" half on 404/410, never on 403, so the default
# GOPROXY=https://proxy.golang.org,direct never actually reaches "direct"
# for this. goproxy.io mirrors the same module data from separate
# infrastructure. ",direct" is kept as a second fallback, which needs git
# (not in this base image) to resolve a vanity import path like
# golang.org/x/sys by cloning its VCS directly.
ENV GOPROXY=https://goproxy.io,direct
RUN apk add --no-cache git
RUN CGO_ENABLED=0 go install github.com/pressly/goose/v3/cmd/goose@v3.28.0

# --- sqlc (query code generator) - same reasoning as goose above -----------------
FROM golang:1.27-alpine AS sqlc
ENV GOPROXY=https://goproxy.io,direct
RUN apk add --no-cache git
RUN CGO_ENABLED=0 go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1

# --- go binary -----------------------------------------------------------------
# internal/db/generated/ is gitignored (sqlc-generated, regenerated from
# internal/db/queries/*.sql - see sqlc.yaml) rather than committed, so it
# has to be generated here before `go build` can see those packages at all.
FROM golang:1.27-alpine AS gobuild
# Same goproxy.io reasoning as the goose/sqlc stages above - this project's
# own dependency tree transitively pulls in klauspost/compress too (a
# different version, but the same package that was 403ing), so the plain
# default GOPROXY hits the exact same gap here.
ENV GOPROXY=https://goproxy.io,direct
RUN apk add --no-cache git
WORKDIR /src
COPY --from=sqlc /go/bin/sqlc /usr/local/bin/sqlc
COPY go.mod go.sum ./
RUN go mod download
COPY sqlc.yaml ./
COPY cmd/ cmd/
COPY internal/ internal/
RUN sqlc generate
RUN CGO_ENABLED=0 go build -o /out/panel ./cmd/panel

# --- runtime -------------------------------------------------------------------
FROM alpine:3.20
# postgresql16-client: the panel shells out to the real pg_dump/psql
# binaries for its own backup/restore and legacy-panel-import endpoints
# (internal/httpapi/backup.go) - every prior deployment ran the binary
# directly on a host that happened to already have these installed, so
# this gap was never exposed until an actual restore was attempted through
# this image: "pg_dump: exec: \"pg_dump\": executable file not found in
# $PATH". Matches postgres:16-alpine in docker-compose.prod.yml.
RUN apk add --no-cache ca-certificates postgresql16-client
WORKDIR /app
COPY --from=gobuild /out/panel ./panel
COPY --from=goose /go/bin/goose /usr/local/bin/goose
COPY internal/db/migrations ./internal/db/migrations
COPY --from=dashboard /src/web/dist ./web/dist
EXPOSE 8000 8001
ENTRYPOINT ["./panel"]
